# Copy this file to .env and enter keys issued to you.
# Never commit .env or paste keys into code, data files, or chat.
OPENDART_API_KEY=
DATA_GO_KR_API_KEY=

# Neo4j local connection. Put the password only in your ignored .env file.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# OpenAI API extraction. Keep this key only in the ignored local .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_COST_USD=1.75
