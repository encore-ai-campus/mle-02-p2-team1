{"entity_id":"COMPANY-ETUDE","type":"Company","name":"주식회사 에뛰드","source_records":[{"source":"M4_structured","record":{"entity_id":"COMPANY-ETUDE","type":"Company","name":"주식회사 에뛰드","properties":{"dart_corp_code":"00183808","input_name":"에뛰드","industry":"화장품 및 화장용품 도매업","main_business":"에뛰드는 메이크업을 쉽고 재미있게 경험하는 '화장놀이'를 강조하는 색조 브랜드다. 아이섀도 팔레트, 틴트, 마스카라 등을 판매하며, 여러 색상을 하나의 팔레트로 구성하거나 퍼스널 컬러와 MBTI를 결합하는 등 제품에 놀이와 선택의 요소를 더한다. 다양한 색상을 시도하고 그날의 분위기에 맞춰 메이크업을 조합하는 데 관심 있는 고객을 대상으로 한다.","listing_status":"비상장","employee_count":89,"established_date":"1966-02-19"},"evidence":{"company_record":{"company_id":"COMPANY-ETUDE","input_name":"에뛰드","legal_name":"주식회사 에뛰드","dart_corp_code":"00183808"},"field_sources":{"established_date":[{"source_type":"public_data","source_name":"Open DART 기업개황 API","title":"기업개황 조회","original_url":"https://opendart.fss.or.kr/api/company.json","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":"est_dt","raw_path":null}],"main_business":[{"source_type":"disclosure","source_name":"아모레퍼시픽홀딩스","title":"2025년 사업보고서","original_url":"https://kind.krx.co.kr/external/2026/03/18/001082/20260318005107/11011.htm","published_at":null,"collected_at":null,"as_of_date":"2025-12-31","evidence_location":"연결재무제표 주석 1.2 종속기업의 현황","raw_path":null},{"source_type":"official_website","source_name":"아모레퍼시픽","title":"에뛰드 브랜드 역사","original_url":"https://www.apgroup.com/int/ko/about-us/amorepacific/our-history/our-history.html","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":null,"raw_path":null},{"source_type":"official_website","source_name":"아모레퍼시픽","title":"에뛰드 MBTEye 팔레트 소개","original_url":"https://www.apgroup.com/int/ko/news/2024-01-29-2.html","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":null,"raw_path":null}],"listing_status":[{"source_type":"disclosure","source_name":"아모레퍼시픽홀딩스","title":"2026년 1분기 보고서","original_url":"https://kind.krx.co.kr/external/2026/05/15/001430/20260515003119/1