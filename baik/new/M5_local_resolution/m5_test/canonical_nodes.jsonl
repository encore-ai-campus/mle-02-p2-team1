{"entity_id":"COMPANY-AMOREPACIFIC","type":"Company","name":"주식회사 아모레퍼시픽","source_records":[{"source":"M4_structured","record":{"entity_id":"COMPANY-AMOREPACIFIC","type":"Company","name":"주식회사 아모레퍼시픽","properties":{"dart_corp_code":"00583424","input_name":"아모레퍼시픽","industry":"화장품 제조업","main_business":"아모레퍼시픽은 화장품과 생활용품을 제조·판매하고 건강기능식품도 판매하는 뷰티 기업이다. 인삼 연구를 바탕으로 한 스킨케어 브랜드 설화수, 수분 관리를 강조하는 라네즈, 현대적인 메이크업을 선보이는 헤라 등 다양한 브랜드를 운영한다. 스킨케어와 메이크업부터 샴푸·바디케어 같은 생활용품까지 여러 제품군을 통해 고객의 피부 고민과 생활 방식, 취향에 맞는 선택지를 제공한다.","listing_status":"상장","employee_count":4360,"established_date":"2006-06-01"},"evidence":{"company_record":{"company_id":"COMPANY-AMOREPACIFIC","input_name":"아모레퍼시픽","legal_name":"주식회사 아모레퍼시픽","dart_corp_code":"00583424"},"field_sources":{"established_date":[{"source_type":"public_data","source_name":"Open DART 기업개황 API","title":"기업개황 조회","original_url":"https://opendart.fss.or.kr/api/company.json","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":"est_dt","raw_path":null}],"listing_status":[{"source_type":"disclosure","source_name":"아모레퍼시픽홀딩스","title":"2026년 1분기 보고서","original_url":"https://kind.krx.co.kr/external/2026/05/15/001430/20260515003119/11013.htm","published_at":"2026-05-15","collected_at":null,"as_of_date":"2026-03-31","evidence_location":"상세표 - 2. 계열회사 현황","raw_path":null}],"main_business":[{"source_type":"disclosure","source_name":"아모레퍼시픽","title":"아모레퍼시픽 2024년 3분기 보고서","original_url":"https://kind.krx.co.kr/external/2024/11/14/001162/20241114002502/11013.htm","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":"회사 개요 - 주요 사업의 내용","raw_path":null},{"source_type":"official_website","source_name":"아모레퍼시픽","title":"브랜드 목록","original_url":"https://www.apgroup.com/int/ko/brands/brands.html","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":null,"raw_path":null},{"source_type":"official_website","source_name":"아모레퍼시픽","title":"브랜드 역사","original_url":"https://www.apgroup.com/in