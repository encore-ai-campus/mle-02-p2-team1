{"entity_id":"COMPANY-AMOSPROFESSIONAL","type":"Company","name":"주식회사 아모스프로페셔널","source_records":[{"source":"M4_structured","record":{"entity_id":"COMPANY-AMOSPROFESSIONAL","type":"Company","name":"주식회사 아모스프로페셔널","properties":{"dart_corp_code":"00144456","input_name":"아모스프로페셔널","industry":"화장품 및 화장용품 도매업","main_business":"아모스프로페셔널은 헤어 디자이너와 미용실을 위한 전문 헤어 기업으로, '아모스프로페셔널'과 프리미엄 살롱 케어 브랜드 '아윤채'를 운영한다. 두피·모발 관리 제품뿐 아니라 염모제와 스타일링 제품 등 미용실 시술과 관리에 쓰이는 제품을 선보인다. 헤어 디자이너를 대상으로 교육과 협업도 진행하며, 살롱 중심의 전문적인 헤어 관리에 관심 있는 고객과 전문가를 대상으로 한다.","listing_status":"비상장","employee_count":87,"established_date":"1976-01-24"},"evidence":{"company_record":{"company_id":"COMPANY-AMOSPROFESSIONAL","input_name":"아모스프로페셔널","legal_name":"주식회사 아모스프로페셔널","dart_corp_code":"00144456"},"field_sources":{"established_date":[{"source_type":"public_data","source_name":"Open DART 기업개황 API","title":"기업개황 조회","original_url":"https://opendart.fss.or.kr/api/company.json","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":"est_dt","raw_path":null}],"main_business":[{"source_type":"disclosure","source_name":"아모레퍼시픽홀딩스","title":"2025년 사업보고서","original_url":"https://kind.krx.co.kr/external/2026/03/18/001082/20260318005107/11011.htm","published_at":null,"collected_at":null,"as_of_date":"2025-12-31","evidence_location":"연결재무제표 주석 1.2 종속기업의 현황","raw_path":null},{"source_type":"official_website","source_name":"아모레퍼시픽","title":"아모스프로페셔널 브랜드 소개","original_url":"https://www.apgroup.com/int/ko/brands/amos-professional.html","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":null,"raw_path":null},{"source_type":"official_website","source_name":"아모레퍼시픽","title":"아모스프로페셔널과 아윤채 소개","original_url":"https://www.apgroup.com/int/ko/sustainability/sustainability-reports/__icsFiles/afieldfile/2020/05/13/2018_AMOREPACIFIC_SR_Korean.pdf","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":null,"raw_path":null},{"source_type":"official_website","source_nam