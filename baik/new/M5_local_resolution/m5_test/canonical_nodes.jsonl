{"entity_id":"COMPANY-ESPOIR","type":"Company","name":"주식회사 에스쁘아","source_records":[{"source":"M4_structured","record":{"entity_id":"COMPANY-ESPOIR","type":"Company","name":"주식회사 에스쁘아","properties":{"dart_corp_code":"01061150","input_name":"에스쁘아","industry":"화장품 및 화장용품 도매업","main_business":"에스쁘아는 전문 메이크업의 색상과 질감을 강조하는 색조 브랜드다. 쿠션과 파운데이션, 프라이머, 블러셔, 립 제품 등을 판매하며, 특히 얼굴 바탕을 표현하는 페이스 메이크업 제품군을 폭넓게 선보인다. 피부 톤에 맞는 색상과 촉촉하거나 보송한 표현을 고를 수 있도록 제품을 구성해, 피부 표현과 색상 선택을 중요하게 생각하는 고객을 대상으로 한다.","listing_status":"비상장","employee_count":78,"established_date":"2015-01-02"},"evidence":{"company_record":{"company_id":"COMPANY-ESPOIR","input_name":"에스쁘아","legal_name":"주식회사 에스쁘아","dart_corp_code":"01061150"},"field_sources":{"established_date":[{"source_type":"public_data","source_name":"Open DART 기업개황 API","title":"기업개황 조회","original_url":"https://opendart.fss.or.kr/api/company.json","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":"est_dt","raw_path":null}],"main_business":[{"source_type":"disclosure","source_name":"아모레퍼시픽홀딩스","title":"2025년 사업보고서","original_url":"https://kind.krx.co.kr/external/2026/03/18/001082/20260318005107/11011.htm","published_at":null,"collected_at":null,"as_of_date":"2025-12-31","evidence_location":"연결재무제표 주석 1.2 종속기업의 현황","raw_path":null},{"source_type":"official_website","source_name":"아모레퍼시픽","title":"에스쁘아 브랜드 소개","original_url":"https://www.apgroup.com/int/ko/news/2019-01-23.html","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":null,"raw_path":null},{"source_type":"official_website","source_name":"아모레퍼시픽홀딩스","title":"2026년 1분기 경영 활동","original_url":"https://www.apgroup.com/int/ko/investors/amorepacific-holdings-corp/ir-reports/quarterly-results/__icsFiles/afieldfile/2026/04/28/APH_1Q26_KR.pdf","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":null,"raw_path":null}],"listing_status":[{"source_type":"disclosure","source_name":"아모레퍼시픽홀딩스","title":"2026년 1분기 보고서","original_u