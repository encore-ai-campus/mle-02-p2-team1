{"entity_id":"COMPANY-PACIFICTECH","type":"Company","name":"주식회사 퍼시픽테크","source_records":[{"source":"M4_structured","record":{"entity_id":"COMPANY-PACIFICTECH","type":"Company","name":"주식회사 퍼시픽테크","properties":{"dart_corp_code":"01784251","input_name":"퍼시픽테크","industry":"기타 가정용 전기 기기 제조업","main_business":"퍼시픽테크는 아모레퍼시픽홀딩스의 자회사로, 미용기기의 유통과 판매를 목적으로 설립된 기업이다. 아모레퍼시픽의 뷰티 사업과 연계할 수 있는 뷰티 디바이스 사업을 추진하고 있다. 구체적으로 담당하는 제품이나 브랜드는 확인된 자료가 부족해 추가 조사가 필요하다.","listing_status":"비상장","employee_count":6,"established_date":"2023-07-27"},"evidence":{"company_record":{"company_id":"COMPANY-PACIFICTECH","input_name":"퍼시픽테크","legal_name":"주식회사 퍼시픽테크","dart_corp_code":"01784251"},"field_sources":{"established_date":[{"source_type":"public_data","source_name":"Open DART 기업개황 API","title":"기업개황 조회","original_url":"https://opendart.fss.or.kr/api/company.json","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":"est_dt","raw_path":null}],"main_business":[{"source_type":"disclosure","source_name":"아모레퍼시픽홀딩스","title":"2025년 사업보고서","original_url":"https://kind.krx.co.kr/external/2026/03/18/001082/20260318005107/11011.htm","published_at":null,"collected_at":null,"as_of_date":"2025-12-31","evidence_location":"연결재무제표 주석 1.2 종속기업의 현황","raw_path":null},{"source_type":"other","source_name":"퍼시픽테크 채용 공고","title":"뷰티 디바이스 개발 제품 디자이너","original_url":"https://www.wanted.co.kr/wd/326758","published_at":null,"collected_at":null,"as_of_date":null,"evidence_location":null,"raw_path":null}],"listing_status":[{"source_type":"disclosure","source_name":"아모레퍼시픽홀딩스","title":"2026년 1분기 보고서","original_url":"https://kind.krx.co.kr/external/2026/05/15/001430/20260515003119/11013.htm","published_at":"2026-05-15","collected_at":null,"as_of_date":"2026-03-31","evidence_location":"상세표 - 2. 계열회사 현황","raw_path":null}]}},"review_status":"원출처_검토_필요"}},{"source":"disclosure","record":{"entity_id":"COMPANY-PACIFICTECH","name":"주식회사 퍼시픽테크","type":"Company","identity_status":"기존_대표ID"}},{"source":"compa